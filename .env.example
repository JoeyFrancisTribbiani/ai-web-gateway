# ai-web-gateway 环境变量模板
# 复制为 .env 并填写实际值

# ===== Gateway =====
# 调用方鉴权密钥 (new-api 渠道配置中填入相同的 key)
API_KEY=changeme

# Agent 鉴权令牌 (Agent 连接 WebSocket 和上传/下载文件时使用)
AGENT_TOKEN=agent-secret

# 外部可访问的基础 URL (文件 URL 用此地址拼接)
# 如果 Gateway 前面有 Nginx 反向代理，填代理后的地址
PUBLIC_URL=http://localhost:26669

# Redis 连接地址
REDIS_URL=redis://redis:6379

# 同步请求超时 (毫秒) - 对话/图片
AGENT_TIMEOUT=180000

# 同步排队超时 (毫秒) - 无可用 Agent 时的等待上限
QUEUE_TIMEOUT=120000

# 视频排队超时 (毫秒)
VIDEO_QUEUE_TIMEOUT=600000

# 视频生成超时 (毫秒) - 30 分钟
VIDEO_TIMEOUT=1800000

# 每个 Agent 最大标签页数 (6 会话 tab + N 视频轮询 tab)
MAX_TABS_PER_AGENT=12

# 文件存储目录
FILE_DIR=/data/files

# 文件自动清理时间 (小时)
FILE_TTL_HOURS=24

# ===== 告警 =====
# Webhook 地址 (企业微信/钉钉/Slack/飞书，留空则不告警)
ALERT_WEBHOOK=
# 告警去重间隔 (秒，同一告警在此时间内不重复发送)
ALERT_DEDUP_SECONDS=300

# ===== 网络代理 =====
# 代理分流服务器地址 (如 Clash)
# 国外厂商(ChatGPT/Claude/Gemini)走代理线路，国内厂商(豆包/即梦/Kling)直连
# 代理服务器按域名分流，Agent 不关心路由规则
# 留空时 Chrome 直连
HTTP_PROXY=
HTTPS_PROXY=

# ===== Agent =====
# 厂商列表: all 或逗号分隔的厂商名
# all = vendors.yaml 中全部厂商
# chatgpt,claude,gemini = 只加载指定厂商
VENDORS=all

# Gateway WebSocket 地址
GATEWAY_URL=ws://gateway:26669/agent

# Agent 鉴权令牌 (必须与 Gateway 的 AGENT_TOKEN 一致)
# AGENT_TOKEN=agent-secret

# Agent 标识 (可选，默认用容器 hostname)
# AGENT_ID=agent-01

# 资源回收: 每 N 个请求重启 Chrome
MAX_TASKS_PER_CONTEXT=5

# 最大标签页数 (覆盖 Gateway 全局设置)
MAX_TABS=12

# Xvfb 显示号 (同一机器上多个 Agent 需不同，--scale 时各自独立不用改)
DISPLAY=:99

# 流式轮询间隔 (毫秒) - Agent 检测 DOM 增量的频率
POLL_INTERVAL=500

# 文本稳定次数 - 连续 N 次文本无变化判定生成完成
STABLE_COUNT=3

# Chrome 启动参数 (可选, 空格分隔; 不设则使用内置默认值)
# CHROME_ARGS=--no-sandbox --disable-gpu --window-size=1280,800

# VNC 端口 (首次登录用，日常可关闭)
VNC_PORT=5900
# VNC 主机地址 (Gateway noVNC 代理连接 Agent VNC 用)
# 单机部署: 用 Docker 容器名 (如 agent)
# 分布式部署: 用 Agent 服务器 IP 或 hostname
VNC_HOST=agent
