# Gateway 专用环境变量
# docker-compose --env-file .env.gateway up -d gateway redis

API_KEY=changeme
AGENT_TOKEN=agent-secret
PUBLIC_URL=http://localhost:26669
REDIS_URL=redis://redis:6379
AGENT_TIMEOUT=180000
QUEUE_TIMEOUT=120000
VIDEO_QUEUE_TIMEOUT=600000
VIDEO_TIMEOUT=1800000
MAX_TABS_PER_AGENT=8
FILE_DIR=/data/files
FILE_TTL_HOURS=24
ALERT_WEBHOOK=
ALERT_DEDUP_SECONDS=300
